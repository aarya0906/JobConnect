# Copy this file to ".env" for local use. Never commit .env (it's in .gitignore).
# On Render, add these under Environment instead.

# REQUIRED — your Neon connection string (Neon dashboard → Connect). Paste only the URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

PORT=3000
# 1 = on the very first start, fill an EMPTY database with demo companies, jobs and accounts.
# Leave 0 for a real site (demo accounts share a public password).
SEED_DEMO=0
# Set to 1 behind a proxy / PaaS such as Render so rate limiting sees the real client IP.
TRUST_PROXY=0
# Set to 1 to always mark the session cookie Secure (automatic when the proxy sends X-Forwarded-Proto: https).
COOKIE_SECURE=0
