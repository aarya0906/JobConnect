{
  "name": "jobconnect",
  "version": "2.0.0",
  "description": "JobConnect — an online job portal for candidates and employers (Node.js + PostgreSQL/Neon).",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "check-db": "node --env-file-if-exists=.env src/check-db.js"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
