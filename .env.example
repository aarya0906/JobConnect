# Copy to .env and export these in your hosting environment (the app has no dotenv dependency).
PORT=3000
# Where the SQLite database and uploaded resumes are stored. Mount a persistent disk here in production.
DATA_DIR=./data
# Set to 0 on a fresh production database to skip the demo companies, jobs and accounts.
SEED_DEMO=1
# Set to 1 when running behind a reverse proxy / PaaS so rate limiting sees the real client IP.
TRUST_PROXY=0
# Set to 1 to always mark the session cookie Secure (it is also set automatically when X-Forwarded-Proto is https).
COOKIE_SECURE=0
